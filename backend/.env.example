@ -1,31 +0,0 @@
PORT=4000
NODE_ENV=development

# Supabase DB (connection pooling - 일반 쿼리용)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase DB (direct - prisma db push / migrate용)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Gmail SMTP (앱 비밀번호 사용)
MAIL_USER="your-email@gmail.com"
MAIL_PASS="xxxx xxxx xxxx xxxx"

# 프론트엔드 URL (CORS)
FRONTEND_URL=http://localhost:5174

# Kakao OAuth
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# Toss Payments (테스트키: test_sk_ / 라이브키: live_sk_)
TOSS_SECRET_KEY=test_sk_your_toss_secret_key

# Supabase Storage (이미지 업로드)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key